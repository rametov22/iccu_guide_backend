# dev, test, stage, prod
ENVIRONMENT=dev

# Compose
PROJECT_NAME=iccu-guide
APP_PORT=30312
BACKEND_IMAGE=ghcr.io/rametov22/iccu-guide-backend:refactor-django-template

# Django
DJANGO_APP_NAME="ICCU iPad Tour"
# Required in stage/prod; generate with: openssl rand -hex 64
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,backend-asgi
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:30312
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:30312
DJANGO_LOG_LEVEL=INFO

# Monitoring. Generate with: openssl rand -hex 32
DEEP_HEALTH_API_KEY=CHANGE_ME
DEEP_HEALTH_ASGI_URL=http://backend-asgi:8001/healthcheck/

# WSGI / ASGI
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
UVICORN_WORKERS=2

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_DB=iccu_guide_db
POSTGRES_USER=iccu_guide_db_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Redis / Channels
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_ACCESS_LIFETIME_SECONDS=300
JWT_REFRESH_LIFETIME_HOURS=5

# Kiosk
KIOSK_API_TOKEN=CHANGE_ME

# Firebase Cloud Messaging
# Put the service account JSON in ./secrets; this directory is not committed.
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json

# Static and media are stored in Docker named volumes and served by Nginx.
DJANGO_MEDIA_URL=/media/
